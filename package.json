{
  "name": "tabcontext",
  "version": "0.1.0",
  "description": "tabctx: a persistent, sticky browser context for coding assistants, with deterministic JSON output.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "tabctx": "bin/tabctx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}

{
  "name": "agentic-tab-context",
  "version": "0.3.0",
  "description": "Let your coding assistant use the browser tab you already have open, instead of opening a new one.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gainratio/agentic-tab-context.git"
  },
  "homepage": "https://github.com/gainratio/agentic-tab-context",
  "bugs": {
    "url": "https://github.com/gainratio/agentic-tab-context/issues"
  },
  "bin": {
    "atc": "bin/atc.js"
  },
  "files": ["bin/", "dist/", "extension/", "skills/", "README.md", "PRIVACY.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "gate": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}

{
  "name": "agentic-tab-context",
  "version": "0.2.0",
  "description": "agentic-tab-context (atc / abt): discover and bind to the browser tab you already have open across Chrome, Safari, Firefox, Brave, and Edge — deterministic JSON CLI + browser extension + coding assistant skill.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gainratio/agentic-tab-context.git"
  },
  "homepage": "https://github.com/gainratio/agentic-tab-context",
  "bugs": {
    "url": "https://github.com/gainratio/agentic-tab-context/issues"
  },
  "bin": {
    "atc": "bin/atc.js",
    "agentic-tab-context": "bin/atc.js",
    "abt": "bin/abt.js",
    "agentic-browser-tab": "bin/abt.js",
    "tabctx": "bin/tabctx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "check": "npm run typecheck && npm test",
    "gate": "npm run build && npm run typecheck && npm test",
    "setup": "npm run build && node bin/atc.js setup"
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}

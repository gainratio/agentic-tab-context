# Agentic Tab Context (`atc`) — optional runtime configuration
#
# All settings below have safe local defaults; an installation works without a `.env` file.
# Copy with `cp .env.example .env` only when overriding paths or test behavior.
#
# NEVER store secrets, passwords, or IPC auth tokens in environment variables:
# `atc` generates a per-install random IPC token automatically inside `${ATC_HOME}/ipc.token` (mode 0600).

# Directory storing daemon sockets (`daemon.sock`, `bridge.sock`), `state.json`, managed profiles,
# and screenshots. Keep paths short (~104-byte Unix domain socket path limit on macOS/Linux).
ATC_HOME=~/.atc

# Optional absolute path to a custom Chromium executable for managed `atc open chromium` sessions.
# Leave empty to auto-detect installed browsers.
ATC_CHROMIUM_PATH=

# Optional comma-separated 32-char lowercase a-p Chrome extension IDs allowed alongside the
# bundled manifest key during `atc setup` and `atc doctor`.
ATC_EXTENSION_IDS=

# Milliseconds before closed tab contexts expire from `state.json` (default: 86400000 = 24 hours).
ATC_CONTEXT_TTL_MS=86400000

# Default `atc open` managed browsers to headless mode when set to `1` (`0` keeps visible windows).
ATC_HEADLESS=0

# Test/CI override only: set to `1` to let `atc bind` attach to unshared extension tabs without
# interactive side-panel/popup approval. Keep `0` in normal developer usage.
ATC_ALLOW_AGENT_BIND=0

# Override allowing `atc upload` to attach files from sensitive dotfile/credential paths.
# Keep `0` so accidental secret uploads are refused.
ATC_ALLOW_SENSITIVE_UPLOAD=0

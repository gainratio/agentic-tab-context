{
  "manifest_version": 3,
  "name": "Agentic Tab Context",
  "version": "0.4.1",
  "description": "Lets your coding assistant see and use the browser tab you already have open, instead of opening a new one.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Agentic Tab Context",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "scripts": [
      "service-worker.js"
    ],
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "agentic-tab-context@gainratio",
      "strict_min_version": "128.0"
    }
  }
}
